# Reference material — copyrighted papers and private design docs, not redistributable
literature/
*.docx

# Bulk data are excluded; preserve an independent backup of historical artifacts.
data/**
caches/
*.zip
*.sdf

# Bulk tabular/sequence dumps, except small fixtures committed on purpose.
*.tsv
*.fasta
!tests/fixtures/**

# Generated artifacts. The markdown reports ARE the scientific record and are
# tracked; anything bulkier written beside them is not.
reports/*
!reports/.gitkeep
!reports/*.md

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Env / OS
.env
.DS_Store
