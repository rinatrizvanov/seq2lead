# Copy to .env. Read by docker compose; the Python CLI uses these same values as
# built-in defaults, so export them only when you need to override.
# Host port 5433 by default: 5432 is often already taken by another local Postgres.
SEQ2LEAD_DB_HOST=localhost
SEQ2LEAD_DB_PORT=5433
SEQ2LEAD_DB_NAME=seq2lead
SEQ2LEAD_DB_USER=seq2lead
SEQ2LEAD_DB_PASSWORD=seq2lead
